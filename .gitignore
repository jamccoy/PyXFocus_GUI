# Ignore compiled python modules
*.pyc
# Ignore compiled versions of Fortran
*.so
*.so.dSYM/
*.pyd
# Ignore the DS Store and needed import __init__.pyc
*.DS_Store
*.xml
*.iml
# Ignore files for ipython/jupyter notebook and jupyter lab.
.ipynb_checkpoints/*
# The macOS launcher is a local build artifact (tools/make_launcher.py
# regenerates it, with this machine's interpreter path baked in).
*.app/
# The project's virtual environment. requirements.txt is what is versioned;
# the environment built from it is not.
.venv/
